<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StopWatch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryDark">@color/accent_cyan_dark</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/accent_cyan</item>
        <item name="colorControlHighlight">@color/accent_cyan</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:buttonStyle">@style/StopWatchButton</item>
        <item name="android:editTextStyle">@style/StopWatchEditText</item>
        <item name="android:seekBarStyle">@style/StopWatchSeekBar</item>
        <item name="android:switchStyle">@style/StopWatchSwitch</item>
        <item name="alertDialogTheme">@style/Theme.StopWatch_Dialog</item>
    </style>

    <style name="Theme.StopWatch_Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:background">@color/surface_dark</item>
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="buttonBarPositiveButtonStyle">@style/StopWatchButton_Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/StopWatchButton_Dialog</item>
    </style>

    <style name="Theme.StopWatch_TimePicker" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:background">@color/surface_dark</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="TabTextStyle">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="StopWatchButtonPrimary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="StopWatchButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_secondary_bg</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="StopWatchButtonDanger" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_danger_bg</item>
        <item name="android:textColor">@color/button_danger_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="StopWatchButton_Dialog" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/accent_cyan</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StopWatchEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_disabled</item>
        <item name="android:background">@drawable/edit_text_background</item>
    </style>

    <style name="StopWatchSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressTint">@color/accent_cyan</item>
        <item name="android:thumbTint">@color/accent_cyan</item>
    </style>

    <style name="StopWatchSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumbTint">@color/accent_cyan</item>
        <item name="android:trackTint">@color/text_secondary</item>
    </style>

    <style name="Theme.StopWatch.Alarm" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
